{
  "name": "codex-switch-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "dev:server": "cargo run --manifest-path src-tauri/Cargo.toml --bin cst-server",
    "server:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-server.ps1",
    "server:local:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-server.ps1 -Build",
    "web:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-web-interface.ps1",
    "web:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-server.ps1",
    "build": "tauri build",
    "build:frontend": "tsc && vite build",
    "build:server": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin cst-server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.3"
  }
}
